rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Website configuration can be read by all visitors, written only by authenticated administrator
    match /website_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null || request.resource.data.updatedBy != null;
    }

    // Community Tasks collection
    match /tasks/{taskId} {
      allow read: if true;
      allow write: if true;
    }

    // Members directory collection
    match /members/{memberId} {
      allow read: if true;
      allow write: if true;
    }

    // Announcements collection
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
